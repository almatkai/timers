{
  "schemaVersion": 3,
  "id": "com.tezbar.native.timers",
  "slug": "timers",
  "name": "Timers",
  "version": "1.0.0",
  "description": "Start, stop, and save countdown timers, directly in Tezbar, with no external dependencies.",
  "author": "ThatNerd",
  "icon": "resources/command-icon.png",
  "runtime": "rust",
  "replaces": [
    "raycast.timers"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "preferences": [
    {
      "name": "selectedSound",
      "type": "dropdown",
      "required": true,
      "title": "Selected Sound",
      "description": "Sound played when a timer finishes.",
      "default": "Submarine",
      "data": [
        {
          "title": "Alarm Clock",
          "value": "alarmClock.wav"
        },
        {
          "title": "Dismembered Woodpecker",
          "value": "dismemberedWoodpecker.wav"
        },
        {
          "title": "Flute Riff",
          "value": "fluteRiff.wav"
        },
        {
          "title": "Level Up",
          "value": "levelUp.wav"
        },
        {
          "title": "Piano Chime",
          "value": "pianoChime.wav"
        },
        {
          "title": "Terminator",
          "value": "terminator.wav"
        },
        {
          "title": "Speak Timer Name",
          "value": "speak_timer_name"
        }
      ]
    },
    {
      "name": "volumeSetting",
      "type": "textfield",
      "required": false,
      "title": "Timer Alert Volume",
      "description": "Volume of the alert sound. Decimal between 0 and 1.",
      "default": "1"
    },
    {
      "name": "ringContinuously",
      "type": "checkbox",
      "required": false,
      "title": "Timer Alert Type",
      "description": "Whether or not to play the timer alert sound continuously until dismissed.",
      "label": "Ring Continuously",
      "default": true
    },
    {
      "name": "showMenuBarIconWhen",
      "type": "dropdown",
      "required": false,
      "title": "Show Menu Bar Icon When",
      "description": "When to show icon in menubar.",
      "default": "always",
      "data": [
        {
          "title": "Always",
          "value": "always"
        },
        {
          "title": "Only When Not Running",
          "value": "onlyWhenNotRunning"
        },
        {
          "title": "Only When Running",
          "value": "onlyWhenRunning"
        },
        {
          "title": "Never",
          "value": "never"
        }
      ]
    },
    {
      "name": "showTitleInMenuBar",
      "type": "checkbox",
      "required": false,
      "title": "Show Title in Menu Bar",
      "description": "Whether or not to show the timer or stopwatch title in the menu bar.",
      "label": "Show title",
      "default": true
    },
    {
      "name": "copyOnSwStop",
      "type": "checkbox",
      "required": false,
      "title": "Copy on Stopwatch Stop",
      "description": "Whether or not to copy the elapsed time on a stopwatch when it is stopped.",
      "label": "Copy elapsed time",
      "default": false
    },
    {
      "name": "closeWindowOnTimerStart",
      "type": "checkbox",
      "required": false,
      "title": "Close Window on Timer Start",
      "description": "Whether or not to close the Tezbar window when a timer or stopwatch is started.",
      "label": "Automatically close window on start",
      "default": false
    },
    {
      "name": "customTimerFormBypass",
      "label": "Skip form if arguments are given",
      "title": "Custom Timer Form Bypass",
      "type": "checkbox",
      "required": false,
      "description": "For the 'Start Custom Timer' command, skip the timer add form if any hour, minute, or second arguments are given.",
      "default": false
    },
    {
      "name": "newTimerInputOrder",
      "type": "dropdown",
      "required": false,
      "title": "New Timer Input Order",
      "description": "Order for input fields in new timer form.",
      "default": "Hours , Minutes, Seconds",
      "data": [
        {
          "title": "Hours, Minutes, Seconds",
          "value": "hhmmss"
        },
        {
          "title": "Seconds, Minutes, Hours",
          "value": "ssmmhh"
        }
      ]
    }
  ],
  "commands": [
    {
      "name": "start2MinuteTimer",
      "title": "Start 2 Minute Timer",
      "description": "Set a countdown for 2 minutes.",
      "mode": "no-view",
      "disabledByDefault": true,
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": null
    },
    {
      "name": "start5MinuteTimer",
      "title": "Start 5 Minute Timer",
      "description": "Set a countdown for 5 minutes.",
      "mode": "no-view",
      "disabledByDefault": true,
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": null
    },
    {
      "name": "start10MinuteTimer",
      "title": "Start 10 Minute Timer",
      "description": "Set a countdown for 10 minutes.",
      "mode": "no-view",
      "disabledByDefault": true,
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": null
    },
    {
      "name": "start15MinuteTimer",
      "title": "Start 15 Minute Timer",
      "description": "Set a countdown for 15 minutes.",
      "mode": "no-view",
      "disabledByDefault": true,
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": null
    },
    {
      "name": "start25MinuteTimer",
      "title": "Start 25 Minute Timer",
      "description": "Set a countdown for 25 minutes.",
      "mode": "no-view",
      "disabledByDefault": true,
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": null
    },
    {
      "name": "start30MinuteTimer",
      "title": "Start 30 Minute Timer",
      "description": "Set a countdown for 30 minutes.",
      "mode": "no-view",
      "disabledByDefault": true,
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": null
    },
    {
      "name": "start45MinuteTimer",
      "title": "Start 45 Minute Timer",
      "description": "Set a countdown for 45 minutes.",
      "mode": "no-view",
      "disabledByDefault": true,
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": null
    },
    {
      "name": "start60MinuteTimer",
      "title": "Start 60 Minute Timer",
      "description": "Set a countdown for 60 minutes.",
      "mode": "no-view",
      "disabledByDefault": true,
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": null
    },
    {
      "name": "start90MinuteTimer",
      "title": "Start 90 Minute Timer",
      "description": "Set a countdown for 90 minutes.",
      "mode": "no-view",
      "disabledByDefault": true,
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": null
    },
    {
      "name": "startCustomTimer",
      "title": "Start Custom Timer",
      "description": "Set a countdown for a custom amount of time.",
      "mode": "view",
      "arguments": [
        {
          "name": "hours",
          "placeholder": "hours",
          "required": false,
          "type": "text"
        },
        {
          "name": "minutes",
          "placeholder": "minutes",
          "required": false,
          "type": "text"
        },
        {
          "name": "seconds",
          "placeholder": "seconds",
          "required": false,
          "type": "text"
        }
      ],
      "keywords": [
        "new"
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": 1000
    },
    {
      "name": "manageTimers",
      "title": "Manage Timers",
      "description": "View, start, or stop existing countdown timers.",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": 1000
    },
    {
      "name": "timersMenuBar",
      "title": "Timers Menu Bar",
      "description": "View, start, or stop existing countdown timers from the Menu Bar.",
      "mode": "menu-bar",
      "interval": "10s",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": 1000
    },
    {
      "name": "startStopwatch",
      "title": "Start Stopwatch",
      "description": "Start a stopwatch",
      "mode": "no-view",
      "arguments": [
        {
          "name": "name",
          "placeholder": "stopwatch name",
          "required": false,
          "type": "text"
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": null
    },
    {
      "name": "manageStopwatches",
      "title": "Manage Stopwatches",
      "description": "View, start, or stop existing stopwatches.",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": 1000
    },
    {
      "name": "dismissTimerAlert",
      "title": "Dismiss Ringing Timer",
      "description": "Stop a ringing alert from a finished timer.",
      "mode": "no-view",
      "keywords": [
        "Dismiss Timer Alert",
        "Alert"
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": null
    },
    {
      "name": "stopwatchMenuBar",
      "title": "Stopwatch Menu Bar",
      "description": "View, start, or stop existing stopwatches from the Menu Bar.",
      "mode": "menu-bar",
      "interval": "10s",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": 1000
    },
    {
      "name": "previewAlertSounds",
      "title": "Preview Alert Sounds",
      "description": "Play samples of different alert sound effects.",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": 1000
    },
    {
      "name": "stopRunningTimer",
      "title": "Stop Running Timer",
      "description": "Stop the running timer closest to completion.",
      "mode": "no-view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": null
    },
    {
      "name": "configureMenubarPresets",
      "title": "Configure Presets in Menu Bar",
      "description": "Configure which presets to show in the Timers Menu Bar.",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 120000,
      "refreshMs": 1000
    }
  ],
  "verification": [
    {
      "platform": "macOS",
      "state": "headless-tested",
      "target": "aarch64-apple-darwin",
      "detail": "Native Rust tests and release build; fixture-host stdio/package validation. Live desktop UI not tested."
    },
    {
      "platform": "Windows",
      "state": "not-run",
      "target": "x86_64-pc-windows-msvc"
    }
  ],
  "execution": "process",
  "protocolVersion": 1,
  "repository": "https://github.com/almatkai/timers",
  "artifacts": {},
  "capabilities": [
    "clipboard",
    "window",
    "background",
    "notifications"
  ],
  "startupProbe": {
    "key": "timers",
    "migrationPaths": [
      "native-v2-store"
    ]
  },
  "migrationPaths": {
    "native-v2-store": "native-extensions-v2/timers/storage.json"
  },
  "files": {}
}
